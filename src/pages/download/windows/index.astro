---
import BaseLayout from "@layouts/BaseLayout.astro"
import Button from "@components/Button.astro";
import latest from "../../../../public/latest.json";
const version = latest.version;
---

<BaseLayout
  title="Download Legcord for Windows"
  description="Download Legcord for Windows 10/11. Lightweight Discord client for x64 and AArch64. Themes, mods, privacy."
  canonical="/download/windows"
>
  <div class="py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-center text-white mb-8">Download Legcord for Windows 10/11</h1>
      <h2 class="text-2xl font-semibold text-white mb-6 text-center">Select your system architecture:</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <Button name="64-bit (x64)" href={`https://github.com/Legcord/Legcord/releases/download/v${version}/Legcord-${version}-win-x64.exe`} target="_blank" rel="noopener noreferrer" description="For most modern computers" />
        <Button name="ARM64" href={`https://github.com/Legcord/Legcord/releases/download/v${version}/Legcord-${version}-win-arm64.exe`} target="_blank" rel="noopener noreferrer" description="For ARM-based devices" />
      </div>
      <div class="mt-8 text-center">
        <p class="text-gray-300">
          Not sure which architecture your system uses? 
          <a href="https://support.microsoft.com/en-us/windows/32-bit-and-64-bit-windows-frequently-asked-questions-c6ca9541-8dce-4d48-0415-94a3faa2e13d" class="text-blue-400 hover:underline" target="_blank" rel="noopener noreferrer">
            Learn more about system architectures
          </a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>